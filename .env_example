# Environment Variables Example
# Copy this file to .env_local and replace with your actual values

# =============================================================================
# LLM API Keys (choose one or both)
# =============================================================================

# Anthropic API Key - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# OpenAI API Key - only needed if using OpenAI LLM models (gpt-4o etc.)
# Note: NOT used for speech/TTS (those use Deepgram and ElevenLabs)
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Speech Services
# =============================================================================

# ElevenLabs API Key (Speech-to-Text + Text-to-Speech) - Get from https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here